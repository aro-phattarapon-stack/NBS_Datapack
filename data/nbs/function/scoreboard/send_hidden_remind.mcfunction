# เล่นเสียงแจ้งเตือนซ้ำ
execute as @a at @s run playsound minecraft:block.bell.resonate master @s ~ ~ ~ 0.8 1.0

# 1. กรณีพบเฉพาะไข่มังกร (Dragon Egg)
execute if score #egg_in_chest item_count matches 1.. if score #star_in_chest item_count matches 0 if score #nametag_in_chest item_count matches 0 run tellraw @a ["",{"text":"⚠️ [เตือนซ้ำ] ","color":"gold","bold":true},{"text":"ขณะนี้มี ","color":"yellow"},{"text":"ไข่มังกร (Dragon Egg)","color":"light_purple","bold":true},{"text":" ยังคงถูกซ่อนอยู่นอกอาณาเขตธง! พิกัด ","color":"yellow"},{"text":"[ X: ","color":"gray"},{"score":{"name":"#pos","objective":"flag_x"},"color":"aqua","bold":true},{"text":", Y: ","color":"gray"},{"score":{"name":"#pos","objective":"flag_y"},"color":"aqua","bold":true},{"text":", Z: ","color":"gray"},{"score":{"name":"#pos","objective":"flag_z"},"color":"aqua","bold":true},{"text":" ]","color":"gray"}]

# 2. กรณีพบเฉพาะ Nether Star
