# Web Server
PORT=3000
APP_MODE=demo
# บังคับตั้งค่ารหัสผ่านแอดมินอย่างน้อย 12 ตัวอักษร (Server จะปฏิเสธ Startup หากว่างหรือใช้ค่า Default)
ADMIN_TOKEN=replace_with_random_32_char_secret

# PostgreSQL (ปล่อยว่างได้หากต้องการรันในโหมด In-Memory ชั่วคราว)
DATABASE_URL=postgres://nbs:nbs_secret_change_me@127.0.0.1:5432/nbs_smp

# Minecraft Server RCON (ตั้งค่าใน server.properties: enable-rcon=true, rcon.port=25575)
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=change_this_rcon_password
RCON_POLL_MS=3000

# AI Game Director (Optional — หากไม่ใส่ ระบบจะใช้ Stage-Weighted Pool Fallback อัตโนมัติ)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
